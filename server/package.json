{
    "name": "revit-mcp-server",
    "version": "1.0.0",
    "description": "MCP server for interacting with Autodesk Revit",
    "main": "index.js",
    "type": "module",
    "bin": {
        "revit-mcp-server": "./build/index.js"
    },
    "engines": {
        "node": ">=20.0.0"
    },
    "scripts": {
        "clean": "rimraf build",
        "prebuild": "npm run clean",
        "build": "tsc",
        "prepublishOnly": "npm run build"
    },
    "files": [
        "build",
        "README.md"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/paulkotov/revit-mcp-server"
    },
    "keywords": [
