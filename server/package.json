        "ai",
        "bim"
    ],
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "bugs": {
        "url": "https://github.com/paulkotov/revit-mcp-server"
    },
    "homepage": "https://github.com/paulkotov/revit-mcp-server",
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.7.0",
        "better-sqlite3": "^12.8.0",
        "ws": "^8.18.1",
        "zod": "^3.24.2"
    },
    "devDependencies": {
        "@types/better-sqlite3": "^7.6.13",
        "@types/node": "^22.13.10",
        "@types/ws": "^8.18.0",
        "rimraf": "^5.0.10",
        "typescript": "^5.8.2"
    }
}