{
    "name": "revit-mcp-server",
    "version": "1.0.0",
    "description": "MCP server for interacting with Autodesk Revit",
    "main": "index.js",
    "type": "module",
    "bin": {
        "revit-mcp-server": "./build/index.js"
    },
    "engines": {
        "node": ">=20.0.0"
    },
    "scripts": {
        "clean": "rimraf build",
        "prebuild": "npm run clean",
        "build": "tsc",
        "prepublishOnly": "npm run build"
    },
    "files": [
        "build",
        "README.md"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/paulkotov/revit-mcp-server"
    },
    "keywords": [
        "mcp",
        "revit",
        "ai",
        "bim"
    ],
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "bugs": {
        "url": "https://github.com/paulkotov/revit-mcp-server"
    },
    "homepage": "https://github.com/paulkotov/revit-mcp-server",
    "dependencies": {
        "@modelcontextprotocol/ext-apps": "^2.0.3",
        "@modelcontextprotocol/sdk": "^1.32.1",
        "better-sqlite3": "^13.0.3",
        "ws": "^8.22.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/better-sqlite3": "^9.6.0",
        "@types/node": "^26.6.5",
        "@types/ws": "^8.18.2",
        "rimraf": "^6.1.3",
        "typescript": "^7.0.2"
    }
}
